# Get free API keys (all genuinely free, no card required):
# Groq:          https://console.groq.com/keys
# OpenRouter:    https://openrouter.ai/keys
# Gemini:        https://aistudio.google.com/apikey
# Hugging Face:  https://huggingface.co/settings/tokens (needs "Inference Providers" permission)

GROQ_API_KEY=your_key_here
OPENROUTER_API_KEY=your_key_here
GOOGLE_GEMINI_API_KEY=your_key_here

# Hugging Face: single key, or a comma-separated list to rotate across on
# 429/401/403 (one exhausted free-tier token falls through to the next).
# HUGGINGFACE_API_KEY=your_key_here
HUGGINGFACE_API_KEYS=key1,key2,key3
